<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1;assembly=MauiApp1.Core"
    x:Class="MauiApp1.ItemListPage"
    x:DataType="local:ItemListViewModel"
    Title="Items">

    <CollectionView ItemsSource="{Binding Items.Items}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:Item">
                <Label Text="{Binding Name}" Padding="20,12" />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
