<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RootNamespace>Plugin.Maui.MVVMExpress.Compatibility.CommunityToolkit</RootNamespace>
    <AssemblyName>Plugin.Maui.MVVMExpress.Compatibility.CommunityToolkit</AssemblyName>
    <PackageId>Plugin.Maui.MVVMExpress.Compatibility.CommunityToolkit</PackageId>
    <Title>.NET MAUI MVVMExpress — CommunityToolkit adapters</Title>
    <Description>Optional adapters from CommunityToolkit.Mvvm (IMessenger) onto MVVMExpress IMessageHub. Not a type-forwarding fork.</Description>
    <PackageTags>dotnet-maui;maui;mvvm;communitytoolkit;mauiessentials;mvvm-express</PackageTags>
    <Version>0.6.1-preview</Version>
    <PackageReleaseNotes>0.6.1-preview: UI-thread-safe navigator, UseNavigationPage + replace-root. ResetAsync now replaces window.Page with a NavigationPage (no longer PopToRoot+Push). SectionHostViewModel, SnapshotCollection, SearchQuery.CommittedText, FormViewModel.Bind.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\Plugin.Maui.MVVMExpress.Core\Plugin.Maui.MVVMExpress.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
