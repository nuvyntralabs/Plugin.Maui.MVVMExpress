<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <RootNamespace>Plugin.Maui.MVVMExpress</RootNamespace>
    <AssemblyName>Plugin.Maui.MVVMExpress.Core</AssemblyName>
    <PackageId>Plugin.Maui.MVVMExpress.Core</PackageId>
    <Title>.NET MAUI MVVMExpress Core — ViewModels, commands, state</Title>
    <Description>UI-framework-free MVVM primitives: ObservableModel, ViewModel lifecycle, async commands, AsyncState, Outcome, messaging, INavigator, ICache, and IAuthState. No MAUI reference.</Description>
    <PackageTags>dotnet-maui;maui;maui-plugin;maui-utilities;cross-platform;android;ios;nuget;mauiessentials;mvvm;mvvm-express;commands;async-state;messenger</PackageTags>
    <Authors>Niladri</Authors>
    <Company>MauiEssentials</Company>
    <Copyright>Copyright © 2026 Niladri</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://nuvyntralabs.github.io/packages/plugin-maui-mvvmexpress/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nuvyntralabs/Plugin.Maui.MVVMExpress</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>0.4.0-preview</Version>
    <PackageReleaseNotes>0.4.0-preview: page host, URI stack, dictionary/URI args, multi-window root, MauiNotifier toast.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsPackable>true</IsPackable>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.Maui.MVVMExpress.Core.Tests" />
    <InternalsVisibleTo Include="Plugin.Maui.MVVMExpress.Testing" />
  </ItemGroup>

</Project>
