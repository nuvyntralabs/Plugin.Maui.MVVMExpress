<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:win="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Windows;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.TwoWindowPage"
    x:DataType="win:TwoWindowDemoViewModel"
    Title="Two windows">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Two IWindowContext keys. Navigate on A does not change B." />
        <Button Text="Navigate window A" Command="{Binding NavigateACommand}" />
        <Button Text="Navigate window B" Command="{Binding NavigateBCommand}" />
    </VerticalStackLayout>
</pages:SampleContentPage>
