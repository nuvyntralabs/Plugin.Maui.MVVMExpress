<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:gen="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Generated;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.GeneratedCatalogPage"
    x:DataType="gen:GeneratedCatalogViewModel"
    Title="Generated">

    <VerticalStackLayout Padding="20" Spacing="8">
        <Label Text="[Notify] / [NotifyAlso] / [ModelCommand] / AddGeneratedViewModels." />
        <Entry Placeholder="Query" Text="{Binding Query}" />
        <Label Text="{Binding Label}" />
        <Button Text="Clear" Command="{Binding ClearCommand}" />
        <Button Text="Refresh" Command="{Binding RefreshCommand}" />
    </VerticalStackLayout>
</pages:SampleContentPage>
