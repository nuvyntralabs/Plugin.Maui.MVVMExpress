<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:nav="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Navigation;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.HomePage"
    x:DataType="nav:HomeViewModel"
    Title="Navigation">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <Label Text="Open products switches the CRUD flyout. Open details pushes a Shell page with typed ProductId args. Route + query uses the dictionary URI API. Toast uses INotifier." />
            <Button Text="Open products" Command="{Binding OpenProductsCommand}" />
            <Button Text="Open Latte details"
                    Command="{Binding OpenDetailsCommand}"
                    CommandParameter="{x:Int32 2}" />
            <Button Text="Open Latte via URI query" Command="{Binding OpenDetailsByRouteCommand}" />
            <Button Text="Show toast" Command="{Binding ShowToastCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</pages:SampleContentPage>
