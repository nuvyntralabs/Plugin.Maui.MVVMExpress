<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:computed="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Computed;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.ComputedNamePage"
    x:DataType="computed:ComputedNameViewModel"
    Title="NotifyDependsOn">

    <VerticalStackLayout Padding="20" Spacing="8">
        <Entry Placeholder="First" Text="{Binding First}" />
        <Entry Placeholder="Last" Text="{Binding Last}" />
        <Label Text="{Binding FullName}" FontSize="22" FontAttributes="Bold" />
    </VerticalStackLayout>
</pages:SampleContentPage>
