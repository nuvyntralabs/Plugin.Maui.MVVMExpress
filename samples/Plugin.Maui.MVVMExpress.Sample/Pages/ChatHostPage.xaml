<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:controls="clr-namespace:Plugin.Maui.MVVMExpress.Controls;assembly=Plugin.Maui.MVVMExpress"
    xmlns:chat="clr-namespace:Plugin.Maui.MVVMExpress.Samples.ChatHost;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.ChatHostPage"
    x:DataType="chat:ChatHostViewModel"
    Title="Chat host">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="8">
        <controls:SectionHostView Host="{Binding}" />
        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Button Text="Chats" Command="{Binding SelectCommand}" CommandParameter="chats" />
            <Button Text="Calls" Command="{Binding SelectCommand}" CommandParameter="calls" />
        </HorizontalStackLayout>
        <controls:MvvmSearch Grid.Row="2" Placeholder="Filter chats" Text="{Binding Inbox.Search.Text}" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Inbox.Chats.Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="chat:ChatConversation">
                    <VerticalStackLayout Padding="0,8">
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Preview}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</pages:SampleContentPage>
