<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:modals="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Modals;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.ModalHostPage"
    x:DataType="modals:ModalHostViewModel"
    Title="Modal">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="PushModalAsync / PopModalAsync on IPageNavigator." />
        <Label Text="{Binding ModalCount, StringFormat='Modal stack: {0}'}" />
        <Button Text="Open note modal" Command="{Binding OpenModalCommand}" />
    </VerticalStackLayout>
</pages:SampleContentPage>
