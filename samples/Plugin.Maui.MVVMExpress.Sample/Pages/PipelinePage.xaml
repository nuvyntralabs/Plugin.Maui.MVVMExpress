<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:ops="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Operations;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.PipelinePage"
    x:DataType="ops:PipelineViewModel"
    Title="Operation pipeline">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="IOperationExecutor busy / cancel / Outcome." />
        <Label Text="{Binding Runs, StringFormat='Runs: {0}'}" />
        <Label Text="{Binding Last, StringFormat='Last: {0}'}" />
        <Button Text="Run" Command="{Binding RunCommand}" />
    </VerticalStackLayout>
</pages:SampleContentPage>
