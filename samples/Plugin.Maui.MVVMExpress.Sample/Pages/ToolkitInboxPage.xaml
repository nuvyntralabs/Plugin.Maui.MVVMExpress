<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ct="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Compatibility"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.ToolkitInboxPage"
    x:DataType="ct:ToolkitInboxViewModel"
    Title="CommunityToolkit">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Keep ObservableObject. Inject INavigator and IDialogs." />
        <Label Text="{Binding LastAlert}" />
        <Button Text="Open counter" Command="{Binding OpenCounterCommand}" />
        <Button Text="Alert" Command="{Binding WarnCommand}" />
    </VerticalStackLayout>
</ContentPage>
