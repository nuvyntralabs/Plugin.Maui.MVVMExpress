<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:Plugin.Maui.MVVMExpress.Samples.AuthApp;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.AuthApp.Pages.LoginPage"
    x:DataType="auth:AuthLoginViewModel"
    Title="Sign in">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <Label Text="demo@mvvmexpress.dev / secret" />
            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
            <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
            <Button Text="Sign in" Command="{Binding SignInCommand}" />
            <ActivityIndicator IsRunning="{Binding SignInCommand.IsRunning}" IsVisible="{Binding SignInCommand.IsRunning}" />
            <Button Text="Register" Command="{Binding RegisterCommand}" />
            <Button Text="Forgot password" Command="{Binding ForgotCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
