<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:Plugin.Maui.MVVMExpress.Samples.AuthApp;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.AuthApp.Pages.HomePage"
    x:DataType="auth:AuthHomeViewModel"
    Title="Home">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="{Binding Email, StringFormat='Signed in as {0}'}" />
        <Button Text="Sign out" Command="{Binding SignOutCommand}" />
    </VerticalStackLayout>
</ContentPage>
