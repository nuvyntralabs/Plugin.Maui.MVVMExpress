<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:nav="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Navigation;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.ProductDetailsPage"
    x:DataType="nav:ProductDetailsViewModel"
    Title="Details">

    <VerticalStackLayout Padding="20" Spacing="8">
        <ActivityIndicator IsRunning="{Binding Product.IsLoading}" IsVisible="{Binding Product.IsLoading}" />
        <Label Text="{Binding Product.Data.Name}" FontAttributes="Bold" FontSize="20" />
        <Label Text="{Binding Product.Data.Price, StringFormat='Price: {0:C}'}" />
        <Label Text="Product not found" IsVisible="{Binding Product.IsEmpty}" />
        <Label Text="{Binding Product.Error}" TextColor="Red" />
    </VerticalStackLayout>
</pages:SampleContentPage>
