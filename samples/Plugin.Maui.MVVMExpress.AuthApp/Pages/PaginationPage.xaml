<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:paging="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Pagination;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    xmlns:models="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Models;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.PaginationPage"
    x:DataType="paging:PagedProductViewModel"
    Title="Pagination">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="8">
        <Button Text="Refresh" Command="{Binding RefreshCommand}" />
        <Button Grid.Row="1" Text="Load more" Command="{Binding LoadMoreCommand}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Label Text="{Binding Name}" Padding="0,8" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</pages:SampleContentPage>
