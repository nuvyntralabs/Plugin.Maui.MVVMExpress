<?xml version="1.0" encoding="utf-8" ?>
<pages:SampleContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.MVVMExpress.Sample.Pages"
    xmlns:basic="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Basic;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Sample.Pages.CounterPage"
    x:DataType="basic:CounterViewModel"
    Title="Basic">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="{Binding Label}" FontSize="24" />
            <Button Text="Increment" Command="{Binding IncrementCommand}" />
            <Button Text="Decrement" Command="{Binding DecrementCommand}" />
            <Button Text="Reset" Command="{Binding ResetCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</pages:SampleContentPage>
