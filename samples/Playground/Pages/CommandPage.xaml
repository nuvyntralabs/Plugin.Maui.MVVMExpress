<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:play="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Playground;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Playground.Pages.CommandPage"
    x:DataType="play:PlaygroundCommandViewModel"
    Title="Command">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="{Binding Count, StringFormat='Count: {0}'}" FontSize="24" />
        <Button Text="Increment" Command="{Binding IncrementCommand}" />
        <ActivityIndicator IsRunning="{Binding IncrementCommand.IsRunning}" IsVisible="{Binding IncrementCommand.IsRunning}" />
    </VerticalStackLayout>
</ContentPage>
