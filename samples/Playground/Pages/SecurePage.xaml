<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:play="clr-namespace:Plugin.Maui.MVVMExpress.Samples.Playground;assembly=Plugin.Maui.MVVMExpress.Samples.Shared"
    x:Class="Plugin.Maui.MVVMExpress.Playground.Pages.SecurePage"
    x:DataType="play:PlaygroundSecureViewModel"
    Title="Auth">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="{Binding Email, StringFormat='Signed in as {0}'}" />
        <Button Text="Sign out" Command="{Binding SignOutCommand}" />
    </VerticalStackLayout>
</ContentPage>
